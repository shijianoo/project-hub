# 复制为 .env 后使用。请勿将真实密码和密钥提交到版本库。
APP_PORT=8080
POSTGRES_PASSWORD=replace_with_a_strong_database_password
JWT_SECRET=replace_with_at_least_64_random_characters_for_production_security
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=系统管理员
INITIAL_ADMIN_EMPLOYEE_NO=ADMIN
INITIAL_ADMIN_PASSWORD=Replace_With_Strong_Admin_Password_123
ASSET_MAXIMUM_FILE_SIZE_MB=1024
ASSET_MAXIMUM_PACKAGE_SIZE_MB=10240
PUBLIC_WEB_URL=http://localhost:8080/#
REMINDER_TIME_ZONE_ID=Asia/Hong_Kong

# SMTP 可选配置；未配置时站内通知仍会正常生成。
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USE_DEFAULT_CREDENTIALS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=ProjectHub
